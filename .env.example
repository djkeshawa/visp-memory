# Copy this file to .env (gitignored) and fill in your values.
# docker compose auto-loads .env and injects these into the llm-memory services
# via the shared x-llm-memory-env anchor.

# Embedding provider for the server/dashboard.
# Options: openrouter | openai | ollama | auto
LLM_MEMORY_EMBEDDING_PROVIDER=openrouter

# API key for the chosen cloud embedding provider (OpenRouter or OpenAI).
EMBEDDING_API_KEY=sk-or-your-key-here

# Optional: override the embedding model (provider default is used if blank).
# LLM_MEMORY_EMBEDDING_MODEL=

# Neo4j password -- must match the neo4j service (default: memorypass).
NEO4J_PASSWORD=memorypass

# Optional: memory repo namespace. Defaults to "default" to match the Claude MCP.
# LLM_MEMORY_REPO_ID=default
