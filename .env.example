# Copy this file to .env (gitignored) and fill in your values.
# docker compose auto-loads .env and injects these into the visp-memory services
# via the shared x-visp-memory-env anchor.

# Embedding provider for the server/dashboard.
# Options: openrouter | openai | ollama | auto
VISP_MEMORY_EMBEDDING_PROVIDER=openrouter

# API key for the chosen cloud embedding provider (OpenRouter or OpenAI).
EMBEDDING_API_KEY=sk-or-your-key-here

# Optional: override the embedding model (provider default is used if blank).
# VISP_MEMORY_EMBEDDING_MODEL=

# Optional model for consolidation, intent evaluation, reranking, and answers.
# MCP clients may provide their own model through sampling when supported.
VISP_MEMORY_LLM_PROVIDER=none
# VISP_MEMORY_LLM_MODEL=
# VISP_MEMORY_LLM_API_KEY=
# Deprecated compatibility input; accepted but ineffective. Visp Memory never
# changes intent status from evaluation.
# VISP_MEMORY_LLM_INTENT_AUTO_COMPLETE=false

# Required for Neo4j profiles. Generate a unique password before deployment.
NEO4J_PASSWORD=replace-with-a-strong-password

# Host ports are loopback-only unless remote exposure is explicitly requested.
VISP_MEMORY_BIND_HOST=127.0.0.1

# Never switch to an empty SQLite database when a configured backend is unavailable.
VISP_MEMORY_STORAGE_ALLOW_FALLBACK=false
VISP_MEMORY_STORAGE_CONNECT_TIMEOUT_SECONDS=30

# Dashboard authentication. The bootstrap password is used only when no account
# exists; remove it after the first successful startup. Legacy API keys remain
# available for migration and break-glass access.
VISP_MEMORY_BOOTSTRAP_ADMIN_USERNAME=admin
VISP_MEMORY_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
VISP_MEMORY_SERVER_SESSION_COOKIE_SECURE=false
VISP_MEMORY_SERVER_API_KEYS=

# Dashboard landing project (memories are namespaced by repo_id). Set to your
# active project; others stay selectable from the dashboard's repo dropdown.
# VISP_MEMORY_REPO_ID=novel
